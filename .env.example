COMPOSE_FILE=compose.yaml:net.yaml

NGINX_SERVER_WATCH_CRT=/var/local/step
NGINX_SERVER_YAML=/etc/nginx/yaml/servers.yaml
NGINX_ADDRESS=

NODE_WS_CRT=/var/local/step
NODE_WS_REDIS_HOST=redis
NODE_WS_VERIFY_TOKEN=

STEP_CRT_STEP_INIT_NAME=META_CRT
STEP_CRT_STEP_INIT_DNS="meta.local"
STEP_CRT_STEP_INIT_SAN=""
STEP_CRT_STEP_CA_URL=https://ca:5739
STEP_CRT_STEP_FINGERPRINT=
STEP_CRT_STEP_KID=
STEP_CRT_STEP_RENEW_PERIOD=12h

STEP_PROVISIONER_PASSWORD_FILE=${HOME}/.step/provisioner_password

TEMPLATE_DIR=${HOME}/docker/templates
TEMPLATE_DB_REDIS=${TEMPLATE_DIR}/db/redis.yaml
TEMPLATE_NGINX_SERVER=${TEMPLATE_DIR}/nginx/server.yaml
TEMPLATE_NODE_WS=${TEMPLATE_DIR}/node/ws.yaml
TEMPLATE_STEP_CRT=${TEMPLATE_DIR}/step/crt.yaml


